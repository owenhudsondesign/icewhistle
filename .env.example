# ICEwhistle Environment Variables
# Copy this file to .env.local and fill in your values

# ===================
# SUPABASE (Required)
# ===================
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DATABASE_URL="postgres://postgres:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true"

# ===================
# APP CONFIG
# ===================
NEXT_PUBLIC_APP_URL="localhost:3000"

# ===================
# MAPBOX (Required for maps)
# ===================
# Get a free token at https://mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your-mapbox-public-token"

# ===================
# BUNNY CDN (Optional - for media uploads)
# ===================
# Only needed if you want to support video/image uploads
# BUNNY_API_KEY=""
# BUNNY_STREAM_LIBRARY_ID=""
# BUNNY_STORAGE_ZONE=""
# BUNNY_STORAGE_PASSWORD=""
# BUNNY_STORAGE_REGION=""

# ===================
# PUSH NOTIFICATIONS (Optional)
# ===================
# For web push notifications
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
